# Azure OpenAI GPT/Chat Model - for CrewAI LLM
AZURE_OPENAI_ENDPOINT=""
OPENAI_API_VERSION="2023-05-15"
AZURE_OPENAI_API_KEY=""
AZURE_DEPLOYMENT_NAME=""

# Azure Embeddings Service
AZURE_EMBEDDING_MODEL="text-embedding-ada-002"
AZURE_OPENAI_ENDPOINT_EMBED=""
AZURE_OPENAI_API_KEY_EMBED=""
AZURE_EMBEDDING_DEPLOYMENT_NAME=""
AZURE_OPENAI_API_VERSION_EMBED="2023-05-15"

CLOUD_PROVIDER="azure"

DB_USERNAME=""
DB_PASSWORD=""
DB_NAME="postgres"
DB_HOST=""
DB_PORT="5432"

# JWT Secret for authentication, etc.
SECRET_KEY=""

# NOTE: These must match the variables referenced in llm_service.py. 
# e.g. for CrewAI to work, you must set endpoint, API version, deployment name, and API key for Azure OpenAI Chat, as well as embedding model/deployment for vector embedding.
